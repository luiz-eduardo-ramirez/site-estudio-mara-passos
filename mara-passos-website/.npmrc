# O projeto usa o adaptador novo (@opennextjs/cloudflare), mas ainda mantém o
# @cloudflare/next-on-pages nas devDependencies; o peer @cloudflare/workers-types
# dele (v4) conflita com a v5 usada aqui, então o `npm install` sem flag quebra
# com ERESOLVE. Isso fazia o build do Cloudflare Pages falhar logo no install.
# legacy-peer-deps replica a instalação que já usamos localmente.
legacy-peer-deps=true
